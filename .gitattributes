# 统一换行：仓库存 LF，工作区按平台检出
* text=auto eol=lf

# 文本文件
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.svg   text eol=lf
*.tsv   text eol=lf

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.zip   binary
*.exe   binary
